# Режим
NODE_ENV=development
STORE_TIMEZONE=Europe/Moscow
TRUSTED_PROXY_POLICY=VERCEL

# Два Vercel-проекта
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:3001
PLATFORM_API_URL=http://localhost:3001
ADMIN_BASE_URL=http://localhost:3001
ALLOWED_STOREFRONT_ORIGINS=http://localhost:3000

# PostgreSQL (Prisma Postgres / Vercel Marketplace)
DATABASE_URL=
# Необязательно: прямое соединение для миграций, если провайдер выдал отдельный URL
DIRECT_URL=
SHADOW_DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Ключи приложения — отдельные случайные значения, не копировать между клиентами
# Формат PII_KEY_RING_JSON: {"activeKeyId":"v1","keys":{"v1":"BASE64_32_BYTES"}}
PII_KEY_RING_JSON=
PHONE_LOOKUP_HMAC_KEY=
ADMIN_SESSION_HMAC_KEY=
MFA_ENCRYPTION_KEY=
CSRF_HMAC_KEY=
INTERNAL_JOBS_TOKEN=
STOREFRONT_REVALIDATE_SECRET=

# Первый администратор — удалить из Vercel после npm run admin:bootstrap
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Vercel Blob для фото товаров
BLOB_READ_WRITE_TOKEN=

# Фактические реквизиты — обязательны перед реальными заказами
BUSINESS_LEGAL_NAME=
BUSINESS_INN=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_LEGAL_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
LEGAL_DOCS_APPROVED=false

# YooKassa — только для ONLINE_PAYMENT с маршрутом YOOKASSA
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3

# Т-Банк — только для ONLINE_PAYMENT с маршрутом TBANK
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2
PAYMENT_HTTP_TIMEOUT_MS=8000

# Фискальные параметры подтверждает бухгалтер/кассовый провайдер
FISCAL_TAX_SYSTEM=
FISCAL_DEFAULT_VAT_CODE=
FISCAL_PAYMENT_SUBJECT=
FISCAL_PAYMENT_MODE=
FISCAL_MEASURE_PIECE=
FISCAL_MEASURE_PORTION=
FISCAL_MEASURE_KILOGRAM=
FISCAL_DELIVERY_VAT_CODE=
FISCAL_DELIVERY_PAYMENT_SUBJECT=
FISCAL_DELIVERY_PAYMENT_MODE=
FISCAL_DELIVERY_MEASURE=

# Аналитика не загружается без согласия; можно оставить пустым
NEXT_PUBLIC_YANDEX_METRIKA_ID=
